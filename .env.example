# Copy to .env and fill in what you need. Everything has a working default for the demo.
SECRET_KEY=change-this-before-you-deploy
DEBUG=1
ALLOWED_HOSTS=*
# Comma separated, only needed in production over HTTPS, e.g. https://yourname.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# Google Sign-In for clients. Leave empty to use the email-only demo sign-in.
GOOGLE_CLIENT_ID=

# SMS: "mock" only writes to sms_logs. "semaphore" sends through semaphore.co
SMS_BACKEND=mock
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=

# Optional penalty on top of interest once a ticket is past maturity (0.00 = none)
PAWN_PENALTY_RATE=0.00
